{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logsource.schema.json",
  "title": "LogicMonitor LogSource authoring shape",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "description", "appliesTo", "type", "collectionMethod"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "appliesTo": {"type": "string", "minLength": 1},
    "type": {"const": 10},
    "group": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "technicalNotes": {"type": "string"},
    "collectionMethod": {"type": "string", "minLength": 1},
    "collectionInterval": {"type": "integer", "minimum": 0},
    "collectionAttrs": {"type": "object"},
    "filters": {"type": "array", "items": {"type": "object"}},
    "logFields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "resourceMapping": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "collectionAttribute": {"type": "object"}
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["key", "method", "value"],
      "properties": {
        "comment": {"type": "string"},
        "index": {"type": ["string", "null"]},
        "key": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "value": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
