{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logicmodule.common.defs.json",
  "$defs": {
    "scriptBlob": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "groovy",
            "powershell"
          ]
        },
        "content": {
          "type": "string"
        }
      }
    },
    "datapoint": {
      "type": "object",
      "required": [
        "name",
        "dataType",
        "type",
        "interpretMethod",
        "noData",
        "originId"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "dataType": {
          "type": "integer",
          "enum": [
            2,
            4,
            5,
            6,
            7
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "counter",
            "derive",
            "gauge"
          ]
        },
        "interpretMethod": {
          "type": "string",
          "enum": [
            "csv",
            "expression",
            "groovy",
            "json",
            "namevalue",
            "none",
            "regex",
            "textmatch"
          ]
        },
        "interpretExpr": {
          "type": "string"
        },
        "useValue": {
          "type": "string"
        },
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "maxDigits": {
          "type": "integer"
        },
        "noData": {
          "type": "string"
        },
        "clearInterval": {
          "type": "integer"
        },
        "triggerInterval": {
          "type": "integer"
        },
        "originId": {
          "type": "string",
          "minLength": 1
        },
        "statusDisplayNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threshold": {
          "type": "string"
        },
        "alertBody": {
          "type": "string"
        },
        "alertSubject": {
          "type": "string"
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "name",
        "title",
        "lines"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "verticalLabel": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "timeScale": {
          "type": "string"
        },
        "displayPriority": {
          "type": "integer"
        },
        "scale1024": {
          "type": "boolean"
        },
        "rigid": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "datapointName",
              "type"
            ],
            "additionalProperties": true,
            "properties": {
              "datapointName": {
                "type": "string"
              },
              "legend": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "area",
                  "line",
                  "stack"
                ]
              },
              "isVirtual": {
                "type": "boolean"
              }
            }
          }
        },
        "datapoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "datapointName",
              "consolidationFn"
            ],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "datapointName": {
                "type": "string"
              },
              "consolidationFn": {
                "type": "string",
                "enum": [
                  "average",
                  "max",
                  "min"
                ]
              }
            }
          }
        }
      }
    },
    "activeDiscovery": {
      "type": "object",
      "required": [
        "discoveryMethod",
        "enabled",
        "discoveryInterval",
        "groupMethod"
      ],
      "additionalProperties": true,
      "properties": {
        "discoveryMethod": {
          "type": "string",
          "enum": [
            "ad_script"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "discoveryInterval": {
          "type": "string",
          "enum": ["0m", "15m", "60m", "1440m"]
        },
        "groupMethod": {
          "type": "string"
        },
        "deleteInactiveInstances": {
          "type": "boolean"
        },
        "autoDeleteInstances": {
          "type": "boolean"
        },
        "disableDiscoveredInstances": {
          "type": "boolean"
        },
        "showDeletedInstanceDays": {
          "type": "integer"
        },
        "filters": {
          "type": "array"
        },
        "groupExpr": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/scriptBlob"
        }
      }
    }
  },
