    "sortBy": "alertSeverity",
    "displaySettings": {
      "showTypeIcon": true,
      "displayAs": "list"
    },
    "items": [{
      "dataPointName": "*",
      "instanceName": "*",
      "name": "##RESOURCENAME##",
      "dataSourceDisplayName": "DataSource Display Name*",
      "groupBy": "device",
