{
  "position": { "col": 9, "row": 1, "sizex": 4, "sizey": 6 },
  "config": {
    "type": "noc",
    "name": "Resource Health",
    "description": "",
    "theme": "newSolidDarkBlue",
    "interval": 3,
    "timescale": "day",
    "version": 2,
    "ackChecked": true,
    "sdtChecked": true,
    "displayWarnAlert": true,
