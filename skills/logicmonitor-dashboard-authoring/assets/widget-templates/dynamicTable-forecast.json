{
  "position": { "col": 1, "row": 1, "sizex": 8, "sizey": 8 },
  "config": {
    "type": "dynamicTable",
    "name": "Example Forecast Table",
    "description": "",
    "theme": "newSolidDarkBlue",
    "interval": 3,
    "timescale": "day",
    "version": 2,
    "dataSourceFullName": "Display Name (LogicModule_Name)",
    "topX": 10,
    "sortOrder": "descending",
    "displaySettings": { "pageSize": "20" },
    "forecast": {
      "severity": "warn",
      "confidence": 70,
      "timeRange": "Last 30 days",
      "algorithm": "Linear"
    },
    "columns": [
      {
        "rpn": "",
        "dataPointName": "DATAPOINT_NAME",
        "displayType": "raw",
        "minValue": 0,
        "unitLabel": "",
        "maxValue": 100,
        "colorThresholds": [],
        "columnName": "Current Value",
        "enableForecast": true,
        "roundingDecimal": 2
      },
      {
        "rpn": "",
        "dataPointName": "DATAPOINT_NAME",
        "displayType": "percent",
        "minValue": 0,
        "unitLabel": "%",
        "maxValue": 100,
        "colorThresholds": [
          { "level": 1, "threshold": 80, "relation": "gte" },
          { "level": 2, "threshold": 90, "relation": "gte" }
        ],
        "columnName": "Utilization",
        "enableForecast": false,
        "roundingDecimal": 1
      }
    ],
    "rows": [
      {
        "instanceName": "*",
        "label": "##RESOURCENAME##",
        "deviceDisplayName": "*",
        "groupFullPath": "##defaultResourceGroup##"
      }
    ]
  }
}
